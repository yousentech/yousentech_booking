<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_booking" model="ir.module.category"><field name="name">Booking</field><field name="sequence">35</field></record>
  <record id="group_booking_user" model="res.groups"><field name="name">Booking User</field><field name="category_id" ref="module_category_booking"/></record>
  <record id="group_booking_manager" model="res.groups"><field name="name">Booking Manager</field><field name="category_id" ref="module_category_booking"/><field name="implied_ids" eval="[(4, ref('group_booking_user'))]"/></record>
  <record id="rule_event_company" model="ir.rule"><field name="name">Event bookings: allowed companies</field><field name="model_id" ref="model_yousentech_booking_event"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4, ref('group_booking_user'))]"/></record>
  <record id="rule_stay_company" model="ir.rule"><field name="name">Stay bookings: allowed companies</field><field name="model_id" ref="model_yousentech_stay_booking"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4, ref('group_booking_user'))]"/></record>
</odoo>
