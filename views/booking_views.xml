    <field name="model">yousentech.booking.settings</field>
    <field name="arch" type="xml">
      <form string="إعدادات نظام الحجوزات">
        <sheet>
          <div class="oe_title mb-4">
            <h1>إعدادات نظام الحجوزات</h1>
            <p class="text-muted">إدارة إعدادات التشغيل الخاصة بكل شركة / فرع من مكان واحد.</p>
          </div>

          <div class="row g-3">
            <div class="col-12 col-lg-6">
              <div class="card h-100 shadow-sm border-0">
                <div class="card-body p-4">
                  <h3 class="card-title mb-1">الإعدادات العامة</h3>
                  <p class="text-muted mb-4">حدد الشركة ونوع نشاط الحجوزات المستخدم.</p>
                  <group>
                    <field name="company_id" string="الشركة / الفرع"/>
                    <field name="activity_type" string="نوع نشاط الحجز"/>
                  </group>
                </div>
              </div>
            </div>

            <div class="col-12 col-lg-6" invisible="activity_type == 'events'">
              <div class="card h-100 shadow-sm border-0">
                <div class="card-body p-4">
                  <h3 class="card-title mb-1">إعدادات الحجوزات الفندقية</h3>
                  <p class="text-muted mb-4">تحكم في سياسات الإقامة والحجز الفندقي.</p>
                  <group>
                    <field name="allow_open_stay" string="السماح بإقامة مفتوحة بدون تاريخ خروج"/>
                     <field name="stay_default_rate_plan_id" string="خطة سعر الإقامة الافتراضية" options="{'no_create': True, 'no_create_edit': True}"/>
                     <field name="stay_invoice_policy" string="سياسة الفوترة الافتراضية"/>
                     <field name="stay_deposit_percent" string="نسبة العربون الافتراضية" invisible="stay_invoice_policy != 'deposit'"/>
                     <div class="text-muted">الضريبة تُحدد في خطة السعر الافتراضية وتُستخدم في احتساب الحجز والفواتير.</div>
                  </group>
                </div>
              </div>
            </div>
          </div>

          <div class="alert alert-warning mt-4" role="alert">
            بعد بدء عمليات الحجز لا يمكن تغيير نوع النشاط حفاظًا على سلامة البيانات.
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_open_booking_settings" model="ir.actions.server">
    <field name="name">إعدادات النظام</field>
    <field name="model_id" ref="model_yousentech_booking_settings"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open_settings()</field>
  </record>

  <record id="action_booking_settings" model="ir.actions.act_window">
    <field name="name">إعدادات النظام</field>
    <field name="res_model">yousentech.booking.settings</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_booking_settings_form"/>
    <field name="target">current</field>
  </record>


  <record id="view_booking_holiday_tree" model="ir.ui.view">
    <field name="name">yousentech.booking.holiday.tree</field>
    <field name="model">yousentech.booking.holiday</field>
    <field name="arch" type="xml"><tree string="أيام الإجازات" decoration-info="date == context_today()"><field name="date"/><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="active" widget="boolean_toggle"/></tree></field>
  </record>
  <record id="view_booking_holiday_form" model="ir.ui.view">
    <field name="name">yousentech.booking.holiday.form</field>
    <field name="model">yousentech.booking.holiday</field>
    <field name="arch" type="xml"><form string="يوم إجازة"><sheet><group><field name="name"/><field name="date"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group></sheet></form></field>
  </record>
  <record id="action_booking_holidays" model="ir.actions.act_window">
    <field name="name">أيام الإجازات</field><field name="res_model">yousentech.booking.holiday</field><field name="view_mode">tree,form</field>
  </record>
</odoo>
