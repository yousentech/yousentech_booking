  <record id="view_booking_package_tree" model="ir.ui.view"><field name="name">yousentech.booking.package.tree</field><field name="model">yousentech.booking.package</field><field name="arch" type="xml"><tree><field name="sequence" string="الترتيب" widget="handle"/><field name="name" string="الاسم"/><field name="pricing_type" string="طريقة التسعير"/><field name="price" string="السعر"/><field name="company_id" string="الشركة / الفرع"/><field name="active" string="نشط"/></tree></field></record>
  <record id="view_booking_package_form" model="ir.ui.view">
    <field name="name">yousentech.booking.package.form</field>
    <field name="model">yousentech.booking.package</field>
    <field name="arch" type="xml">
      <form string="باقة الحجز" class="yb-package-form">
        <sheet>
          <div class="yb-package-layout">
            <div class="yb-package-card">
              <h3><i class="fa fa-cube"/> بيانات الباقة</h3>
              <group col="2">
                <field name="name" string="اسم الباقة"/>
                <field name="company_id" string="الشركة / الفرع"/>
                <field name="sequence" string="الترتيب"/>
                <field name="active" string="نشط"/>
              </group>
            </div>
            <div class="yb-package-card">
              <h3><i class="fa fa-money"/> إعدادات التسعير</h3>
              <group col="2">
                <field name="pricing_type" string="طريقة التسعير"/>
                <field name="tax_id" string="نوع الضريبة" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="fixed_price" string="السعر الثابت" invisible="pricing_type != 'fixed'"/>
                <field name="services_total" string="إجمالي الخدمات" readonly="1" invisible="pricing_type == 'fixed'"/>
                <field name="price" string="السعر النهائي" readonly="1"/>
              </group>
            </div>
          </div>
          <div class="yb-package-card yb-package-services">
            <h3><i class="fa fa-list"/> الخدمات المشمولة في الباقة</h3>
            <field name="line_ids" nolabel="1">
              <tree editable="bottom">
                <field name="company_id" column_invisible="True"/>
                <field name="sequence" widget="handle"/>
                <field name="service_id" string="الخدمة"/>
                <field name="quantity" string="الكمية"/>
                <field name="price_unit" string="سعر الوحدة" readonly="1" column_invisible="parent.pricing_type == 'fixed'"/>
                <field name="subtotal" string="الإجمالي" readonly="1" column_invisible="parent.pricing_type == 'fixed'"/>
              </tree>
            </field>
          </div>
        </sheet>
      </form>
    </field>
  </record>

