<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_event_booking_list" model="ir.ui.view"><field name="name">yousentech.booking.event.tree</field><field name="model">yousentech.booking.event</field><field name="arch" type="xml"><tree><field name="name" string="الاسم"/><field name="company_id" string="الشركة / الفرع"/><field name="booking_date" string="تاريخ الحجز"/><field name="partner_id" string="العميل"/><field name="hall_id" string="القاعة"/><field name="state" string="الحالة"/></tree></field></record>
  <record id="view_stay_booking_list" model="ir.ui.view"><field name="name">yousentech.stay.booking.tree</field><field name="model">yousentech.stay.booking</field><field name="arch" type="xml"><tree><field name="name" string="الاسم"/><field name="company_id" string="الشركة / الفرع"/><field name="checkin_date" string="تاريخ الدخول"/><field name="checkout_date" string="تاريخ الخروج"/><field name="partner_id" string="العميل"/><field name="resource_id" string="مورد الإقامة"/><field name="state" string="الحالة"/></tree></field></record>

  <record id="view_event_booking_form" model="ir.ui.view">
    <field name="name">yousentech.booking.event.form</field>
    <field name="model">yousentech.booking.event</field>
    <field name="arch" type="xml">
      <form string="حجز قاعة / مناسبة">
        <header>
          <button name="action_hold" type="object" string="حجز مؤقت" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_confirm" type="object" string="تأكيد الحجز" class="btn-primary" invisible="state not in ('draft','hold')"/>
          <button name="action_prepare" type="object" string="بدء التجهيز" invisible="state != 'confirmed'"/>
          <button name="action_start_event" type="object" string="بدء المناسبة" invisible="state != 'preparing'"/>
          <button name="action_complete" type="object" string="إكمال المناسبة" invisible="state != 'event'"/>
          <button name="action_create_invoice" type="object" string="إنشاء فاتورة" groups="yousentech_booking.group_booking_manager" invisible="state not in ('confirmed','preparing','event','completed') or invoice_policy != 'manual'"/>
          <button name="action_create_final_invoice" type="object" string="فاتورة الرصيد" groups="yousentech_booking.group_booking_manager" invisible="state not in ('confirmed','preparing','event','completed') or invoice_policy != 'deposit'"/>
          <button name="action_create_credit_note" type="object" string="إنشاء إشعار دائن" groups="yousentech_booking.group_booking_manager" invisible="invoice_count == 0"/>
          <button name="action_reopen" type="object" string="إعادة فتح" groups="yousentech_booking.group_booking_supervisor" invisible="state != 'cancelled'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,hold,confirmed,preparing,event,completed,cancelled"/>
        </header>
        <sheet>
          <group string="بيانات الحجز الأساسية">
            <group>
              <field name="name" string="رقم الحجز" readonly="1"/>
              <field name="partner_id" string="العميل"/>
              <field name="company_id" string="الشركة / الفرع"/>
            </group>
            <group>
              <field name="booking_date" string="تاريخ الحجز"/>
              <field name="hall_id" string="القاعة"/>
              <field name="period_ids" string="الفترات" widget="many2many_tags"/>
            </group>
          </group>

          <notebook>
            <page string="الباقة والخدمات">
              <group>
                <field name="package_id" string="الباقة"/>
                <field name="discount_type" string="نوع الخصم"/>
                <field name="discount_value" string="قيمة الخصم" invisible="discount_type == 'none'"/>
              </group>
              <field name="service_line_ids" string="الخدمات">
                <tree editable="bottom">
                  <field name="company_id" column_invisible="True"/>
                  <field name="service_id" string="الخدمة"/>
                  <field name="quantity" string="الكمية"/>
                  <field name="price_unit" string="سعر الوحدة"/>
                  <field name="subtotal" string="الإجمالي" readonly="1"/>
                </tree>
              </field>
              <group class="oe_subtotal_footer oe_right">
                <field name="amount_untaxed" string="قبل الضريبة" readonly="1"/>
                <field name="discount_amount" string="الخصم" readonly="1"/>
                <field name="tax_amount" string="الضريبة" readonly="1"/>
                <field name="amount_total" string="الإجمالي" readonly="1"/>
              </group>
            </page>

            <page string="المالية والفواتير">
              <group>
                <group>
                  <field name="invoice_policy" string="سياسة الفوترة"/>
                  <field name="deposit_percent" string="نسبة العربون" invisible="invoice_policy != 'deposit'"/>
                  <field name="finance_state" string="الحالة المالية" readonly="1"/>
                </group>
                <group>
                  <field name="amount_invoiced" string="المفوتر" readonly="1"/>
                  <field name="amount_paid" string="المدفوع" readonly="1"/>
                  <field name="amount_remaining" string="المتبقي" readonly="1"/>
                  <field name="invoice_count" invisible="1"/>
                </group>
              </group>
              <field name="payment_schedule_ids" string="جدول الدفعات" invisible="invoice_policy != 'schedule'">
                <tree editable="bottom">
                  <field name="name" string="الدفعة"/>
                  <field name="due_date" string="تاريخ الاستحقاق"/>
                  <field name="amount" string="المبلغ"/>
                  <field name="state" string="الحالة" readonly="1"/>
                  <field name="invoice_id" string="الفاتورة" readonly="1"/>
                </tree>
              </field>
              <field name="invoice_ids" string="الفواتير" readonly="1">
                <tree>
                  <field name="name" string="الفاتورة"/>
                  <field name="invoice_date" string="التاريخ"/>
                  <field name="amount_total" string="الإجمالي"/>
                  <field name="payment_state" string="حالة الدفع"/>
                  <field name="state" string="الحالة"/>
                </tree>
              </field>
            </page>

            <page string="السجل التجاري">
              <field name="commercial_snapshot_ids" string="نسخ الشروط التجارية" readonly="1">
                <tree>
                  <field name="revision" string="المراجعة"/>
                  <field name="amount_total" string="الإجمالي"/>
                  <field name="locked" string="مقفلة"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_stay_booking_form" model="ir.ui.view">
    <field name="name">yousentech.stay.booking.form</field>
    <field name="model">yousentech.stay.booking</field>
    <field name="arch" type="xml">
      <form string="حجز فندقي">
        <header>
          <button name="action_hold" type="object" string="حجز مؤقت" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_confirm" type="object" string="تأكيد الحجز" class="btn-primary" invisible="state not in ('draft','hold')"/>
          <button name="action_check_in" type="object" string="تسجيل الدخول" invisible="state != 'confirmed'"/>
          <button name="action_check_out" type="object" string="تسجيل الخروج" invisible="state != 'checked_in'"/>
          <button name="action_reopen" type="object" string="إعادة فتح" groups="yousentech_booking.group_booking_supervisor" invisible="state != 'cancelled'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,hold,confirmed,checked_in,checked_out,cancelled"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="name" string="رقم الحجز" readonly="1"/>
              <field name="partner_id" string="العميل"/>
              <field name="company_id" string="الشركة / الفرع"/>
            </group>
            <group>
              <field name="resource_id" string="مورد الإقامة"/>
              <field name="checkin_date" string="تاريخ الدخول"/>
              <field name="checkout_date" string="تاريخ الخروج"/>
            </group>
          </group>
          <group>
            <field name="amount_total" string="الإجمالي" readonly="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

