<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_booking_audit_log_tree" model="ir.ui.view">
    <field name="name">yousentech.booking.audit.log.tree</field>
    <field name="model">yousentech.booking.audit.log</field>
    <field name="arch" type="xml">
      <tree create="0" edit="0" delete="0">
        <field name="create_date" string="التاريخ والوقت"/>
        <field name="user_id" string="المستخدم"/>
        <field name="action" string="العملية"/>
        <field name="reason" string="السبب"/>
        <field name="details" string="التفاصيل"/>
      </tree>
    </field>
  </record>

  <record id="view_event_booking_list" model="ir.ui.view"><field name="name">yousentech.booking.event.tree</field><field name="model">yousentech.booking.event</field><field name="arch" type="xml"><tree><field name="name" string="الاسم"/><field name="company_id" string="الشركة / الفرع" readonly="state not in ('draft','hold')"/><field name="booking_date" string="تاريخ الحجز" readonly="state not in ('draft','hold')"/><field name="partner_id" string="العميل" readonly="state not in ('draft','hold')"/><field name="hall_id" string="القاعة" readonly="state not in ('draft','hold')"/><field name="state" string="الحالة"/></tree></field></record>
  <record id="view_stay_booking_list" model="ir.ui.view"><field name="name">yousentech.stay.booking.tree</field><field name="model">yousentech.stay.booking</field><field name="arch" type="xml"><tree><field name="name" string="الاسم"/><field name="company_id" string="الشركة / الفرع" readonly="state not in ('draft','hold')"/><field name="checkin_date" string="تاريخ الدخول" readonly="state not in ('draft','hold')"/><field name="checkout_date" string="تاريخ الخروج" readonly="state not in ('draft','hold')"/><field name="partner_id" string="العميل" readonly="state not in ('draft','hold')"/><field name="resource_id" string="مورد الإقامة" readonly="state not in ('draft','hold')"/><field name="state" string="الحالة"/></tree></field></record>

  <record id="view_booking_customer_partner_form_inherit" model="ir.ui.view">
    <field name="name">res.partner.form.booking.customer.details</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='mobile']" position="after">
        <field name="yousentech_booking_identity"/>
        <field name="yousentech_booking_nationality_id"/>
      </xpath>
    </field>
  </record>

  <record id="view_event_booking_form" model="ir.ui.view">
    <field name="name">yousentech.booking.event.form</field>
    <field name="model">yousentech.booking.event</field>
    <field name="arch" type="xml">
      <form string="حجز قاعة / مناسبة" class="yb-event-form">
        <header>
          <button name="action_hold" type="object" string="حجز مؤقت" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_confirm" type="object" string="تأكيد الحجز" class="btn-primary" invisible="state not in ('draft','hold')"/>
          <button name="action_prepare" type="object" string="بدء التجهيز" class="btn-primary" invisible="state != 'confirmed'"/>
          <button name="action_start_event" type="object" string="بدء المناسبة" class="btn-primary" invisible="state != 'preparing'"/>
          <button name="action_complete" type="object" string="إكمال المناسبة" class="btn-primary" invisible="state != 'event'"/>
          <button name="action_create_invoice" type="object" string="إنشاء فاتورة" groups="yousentech_booking.group_booking_manager" invisible="state not in ('confirmed','preparing','event','completed') or invoice_policy != 'manual' or amount_to_invoice &lt;= 0"/>
          <button name="action_create_final_invoice" type="object" string="فاتورة الرصيد" groups="yousentech_booking.group_booking_manager" invisible="state not in ('confirmed','preparing','event','completed') or invoice_policy != 'deposit'"/>
          <button name="action_register_payment" type="object" string="تسجيل دفعة" class="btn-primary" invisible="invoice_count == 0 or amount_due &lt;= 0"/>
          <button name="action_cancel" type="object" string="إلغاء الحجز" groups="yousentech_booking.group_booking_supervisor" invisible="state in ('draft','cancelled')"/>
          <button name="action_reopen" type="object" string="إعادة فتح" groups="yousentech_booking.group_booking_supervisor" invisible="state != 'cancelled'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,hold,confirmed,preparing,event,completed,cancelled"/>
        </header>
        <sheet>
          <field name="invoice_count" invisible="1"/><field name="refund_count" invisible="1"/><field name="payment_count" invisible="1"/>
          <field name="amount_due" invisible="1"/><field name="amount_to_invoice" invisible="1"/><field name="package_pricing_type" invisible="1"/>

          <div class="oe_button_box yb-event-smartbox" name="button_box">
            <button name="action_view_history" type="object" class="oe_stat_button" icon="fa-history"><field name="audit_log_count" widget="statinfo" string="السجل"/></button>
            <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="invoice_count == 0"><field name="invoice_count" widget="statinfo" string="الفواتير"/></button>
            <button name="action_view_refunds" type="object" class="oe_stat_button" icon="fa-undo" invisible="refund_count == 0"><field name="refund_count" widget="statinfo" string="المرتجعات"/></button>
            <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money" invisible="payment_count == 0"><field name="payment_count" widget="statinfo" string="المدفوعات"/></button>
          </div>

          <div class="yb-booking-summary-header yb-approved-summary">
            <div class="yb-booking-summary-identity">
              <div class="yb-booking-icon"><i class="fa fa-calendar-check-o"/></div>
              <div><small>ملخص الحجز</small><h1><field name="name" readonly="1"/></h1><span class="yb-summary-type">حجز قاعة ومناسبة</span></div>
            </div>
            <div class="yb-booking-summary-finance">
              <div class="yb-finance-strip-values">
                <div class="yb-finance-metric yb-summary-base">
                  <i class="fa fa-building-o"/>
                  <div class="yb-summary-metric-text"><small invisible="package_id">قيمة القاعة</small><small invisible="not package_id">قيمة الباقة</small><field name="booking_base_amount" nolabel="1" readonly="1"/></div>
                </div>
                <div class="yb-finance-metric yb-summary-addons">
                  <i class="fa fa-plus"/>
                  <div class="yb-summary-metric-text"><small>الخدمات الملحقة</small><field name="booking_addons_amount" nolabel="1" readonly="1"/></div>
                </div>
                <div class="yb-finance-metric yb-summary-discount">
                  <i class="fa fa-percent"/>
                  <div class="yb-summary-metric-text"><small>الخصم</small><field name="discount_amount" nolabel="1" readonly="1"/></div>
                </div>
                <div class="yb-finance-metric yb-summary-tax">
                  <i class="fa fa-file-text-o"/>
                  <div class="yb-summary-metric-text"><small>الضريبة</small><field name="tax_amount" nolabel="1" readonly="1"/></div>
                </div>
                <div class="yb-finance-metric yb-finance-total">
                  <i class="fa fa-credit-card"/>
                  <div class="yb-summary-metric-text"><small>الإجمالي النهائي</small><field name="amount_total" nolabel="1" readonly="1"/></div>
                </div>
              </div>
            </div>
          </div>

          <div class="yb-event-overview">
            <div class="yb-info-card yb-customer-card">
              <div class="yb-info-icon purple"><i class="fa fa-user"/></div>
              <div class="yb-info-body yb-customer-fields"><small>بيانات صاحب الحجز</small><div class="yb-customer-name"><label for="partner_id" string="العميل"/><field name="partner_id" nolabel="1" options="{'no_quick_create': True}" readonly="state not in ('draft','hold')"/></div><div class="yb-customer-detail"><label for="customer_mobile" string="رقم الجوال"/><field name="customer_mobile" nolabel="1" readonly="state not in ('draft','hold')"/></div><div class="yb-customer-detail"><label for="customer_identity" string="رقم الهوية"/><field name="customer_identity" nolabel="1" readonly="state not in ('draft','hold')"/></div><div class="yb-customer-detail"><label for="customer_nationality_id" string="الجنسية"/><field name="customer_nationality_id" nolabel="1" readonly="state not in ('draft','hold')"/></div></div>
            </div>
            <div class="yb-info-card yb-venue-card">
              <div class="yb-info-icon blue"><i class="fa fa-building-o"/></div>
              <div class="yb-info-body">
                <small>المناسبة والقاعة</small>
                <div class="yb-venue-compact">
                  <div class="yb-venue-hall"><label for="hall_id" string="القاعة"/><field name="hall_id" nolabel="1" readonly="state not in ('draft','hold')"/></div>
                  <div class="yb-event-date"><label for="booking_date" string="التاريخ"/><field name="booking_date" nolabel="1" readonly="state not in ('draft','hold')"/></div><div class="yb-event-date yb-hijri-date"><label for="booking_date_hijri" string="التاريخ الهجري (تقريبي)"/><field name="booking_date_hijri" nolabel="1" readonly="1"/></div>
                  <div class="yb-event-periods"><label for="period_ids" string="الفترات"/><field name="period_ids" nolabel="1" widget="many2many_tags" readonly="state not in ('draft','hold')"/></div>
                  <div class="yb-event-periods" invisible="package_id"><label for="hall_period_amount" string="المبلغ"/><field name="hall_period_amount" nolabel="1" readonly="1"/></div>
                  <div class="yb-event-periods"><label for="booking_tax_id" string="نوع الضريبة"/><field name="booking_tax_id" nolabel="1" readonly="1" options="{'no_open': True}"/></div>
                  <div class="yb-package-rate-notice" invisible="not package_id"><i class="fa fa-info-circle"/> سيتم اعتماد سعر الباقة للحجز كاملًا وتجاهل أسعار القاعة والفترات. الخدمات الملحقة المدفوعة تُضاف بشكل مستقل.</div>
                </div>
              </div>
            </div>
          </div>

<div class="yb-event-workspace">
            <section class="yb-work-card yb-work-package">
              <div class="yb-work-heading"><i class="fa fa-cube"/><strong>الباقة والمتطلبات الأساسية</strong></div>
              <div class="yb-work-package-selector">
                <label for="package_id" string="الباقة"/>
                <field name="package_id" nolabel="1" domain="[('company_id','=',company_id),('hall_id','=',hall_id)]" readonly="state not in ('draft','hold')" options="{'no_create': True, 'no_create_edit': True}"/>
              </div>
              <div class="yb-work-help" invisible="package_id">يمكن الحجز بدون باقة، ويُعتمد سعر فترات القاعة.</div>
              <div class="yb-work-help" invisible="not package_id">الخدمات التالية مشمولة في الباقة ولا تُحتسب كخدمات ملحقة.</div>
              <field name="service_line_ids" nolabel="1" readonly="state not in ('draft','hold')">
                <tree editable="bottom">
                  <field name="company_id" column_invisible="True"/>
                  <field name="service_id" string="الخدمة"/>
                  <field name="quantity" string="الكمية"/>
                  <field name="price_unit" string="سعر الوحدة" column_invisible="parent.package_pricing_type == 'fixed'"/>
                  <field name="subtotal" string="الإجمالي" readonly="1" column_invisible="parent.package_pricing_type == 'fixed'"/>
                </tree>
              </field>
            </section>
            <section class="yb-work-card yb-work-addons">
              <div class="yb-work-heading"><i class="fa fa-plus-circle"/><strong>الخدمات الملحقة المدفوعة</strong></div>
              <field name="addon_line_ids" nolabel="1" readonly="state not in ('draft','hold')">
                <tree editable="bottom">
                  <field name="company_id" column_invisible="True"/>
                  <field name="service_id" string="الخدمة" options="{'no_create': True, 'no_create_edit': True}"/>
                  <field name="quantity" string="الكمية"/>
                  <field name="price_unit" string="سعر الوحدة"/>
                  <field name="subtotal" string="الإجمالي" readonly="1"/>
                </tree>
              </field>
            </section>
            <section class="yb-work-card yb-work-finance">
              <div class="yb-work-heading"><i class="fa fa-info-circle"/><strong>تفاصيل التحصيل</strong></div>
              <div class="yb-work-finance-row"><span>المبلغ المدفوع</span><field name="amount_paid" nolabel="1" readonly="1"/></div>
              <div class="yb-work-finance-row"><span>المتبقي</span><field name="amount_remaining" nolabel="1" readonly="1"/></div>
              <div class="yb-work-finance-row"><span>الحالة المالية</span><field name="finance_state" nolabel="1" readonly="1"/></div>
              <div class="yb-work-help">الخصم والملاحظات متاحان في «بيانات إضافية» عند الحاجة.</div>
            </section>
          </div>

          <notebook class="yb-event-tabs">
            <page string="بيانات إضافية">
              <div class="yb-extra-cards">
                <section class="yb-extra-card yb-extra-discount">
                  <div class="yb-extra-card-title"><i class="fa fa-percent"/><strong>إعدادات الخصم</strong></div>
                  <div class="yb-extra-field">
                    <label for="discount_type" string="نوع الخصم"/>
                    <field name="discount_type" nolabel="1" readonly="state not in ('draft','hold')"/>
                  </div>
                  <div class="yb-extra-field" invisible="discount_type == 'none'">
                    <label for="discount_value" string="قيمة الخصم"/>
                    <field name="discount_value" nolabel="1" readonly="state not in ('draft','hold')"/>
                  </div>
                  <div class="yb-extra-note">الخصم يطبّق على الحجز كاملًا عند اختياره.</div>
                </section>
                <section class="yb-extra-card yb-extra-notes">
                  <div class="yb-extra-card-title"><i class="fa fa-file-text-o"/><strong>وصف الحجز والشركة</strong></div>
                  <div class="yb-extra-field">
                    <label for="company_id" string="الشركة / الفرع"/>
                    <field name="company_id" nolabel="1" readonly="state not in ('draft','hold')"/>
                  </div>
                  <div class="yb-extra-field">
                    <label for="description" string="وصف الحجز"/>
                    <field name="description" nolabel="1" placeholder="تفاصيل أو توضيحات خاصة بالحجز..." readonly="state not in ('draft','hold')"/>
                  </div>
                </section>
              </div>
            </page>
                        <page string="المالية">
              <div class="yb-finance-summary">
                <div><small>صافي المفوتر</small><field name="amount_invoiced" nolabel="1" readonly="1"/></div>
                <div><small>إجمالي المقبوض</small><field name="amount_paid" nolabel="1" readonly="1"/></div>
                <div><small>المبلغ المسترد</small><field name="amount_refunded" nolabel="1" readonly="1"/></div>
                <div><small>المطلوب من العميل</small><field name="amount_remaining" nolabel="1" readonly="1"/></div>
              </div>
              <group class="yb-clean-group">
                <group><field name="invoice_policy" string="سياسة الفوترة" readonly="state not in ('draft','hold') or invoice_count &gt; 0"/><field name="deposit_percent" string="نسبة العربون" invisible="invoice_policy != 'deposit'" readonly="state not in ('draft','hold') or invoice_count &gt; 0"/></group>
                <group><field name="finance_state" string="الحالة المالية" readonly="1"/><field name="amount_to_refund" string="مطلوب رده للعميل" readonly="1"/></group>
              </group>
              <field name="payment_schedule_ids" string="جدول الدفعات" invisible="invoice_policy != 'schedule'" readonly="state not in ('draft','hold') or invoice_count &gt; 0"><tree editable="bottom"><field name="name" string="الدفعة"/><field name="due_date" string="تاريخ الاستحقاق"/><field name="amount" string="المبلغ"/><field name="state" string="الحالة" readonly="1"/><field name="invoice_id" string="الفاتورة" readonly="1"/></tree></field>
              <separator string="الفواتير والمرتجعات"/>
              <field name="invoice_ids" string="الفواتير" nolabel="1" readonly="1"><tree><field name="name" string="المستند"/><field name="move_type" string="النوع"/><field name="invoice_date" string="التاريخ"/><field name="amount_total" string="الإجمالي"/><field name="payment_state" string="حالة الدفع"/><field name="state" string="الحالة"/></tree></field>
            </page>

            <page string="السجل التجاري">
              <field name="commercial_snapshot_ids" string="نسخ الشروط التجارية" nolabel="1" readonly="1"><tree><field name="revision" string="المراجعة"/><field name="amount_total" string="الإجمالي"/><field name="locked" string="مقفلة"/></tree></field>
            </page>
            <page string="الإلغاء" invisible="state != 'cancelled'"><group><field name="cancel_reason" string="سبب الإلغاء" readonly="1"/><field name="cancelled_by_id" string="ألغاه" readonly="1"/><field name="cancelled_at" string="تاريخ الإلغاء" readonly="1"/></group></page>
          </notebook>
        </sheet>
        <div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
      </form>
    </field>
  </record>

  <record id="view_stay_booking_form" model="ir.ui.view">
    <field name="name">yousentech.stay.booking.form</field>
    <field name="model">yousentech.stay.booking</field>
    <field name="arch" type="xml">
      <form string="حجز فندقي" class="yb-event-form yb-stay-form">
        <header>
          <button name="action_hold" type="object" string="حجز مؤقت" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_confirm" type="object" string="تأكيد الحجز" class="btn-primary" invisible="state not in ('draft','hold')"/>
          <button name="action_check_in" type="object" string="تسجيل الدخول" invisible="state != 'confirmed'"/>
          <button name="action_check_out" type="object" string="تسجيل الخروج" invisible="state != 'checked_in'"/>
          <button name="action_create_invoice" type="object" string="إنشاء فاتورة" groups="yousentech_booking.group_booking_manager" invisible="state not in ('confirmed','checked_in','checked_out') or invoice_policy != 'manual' or amount_to_invoice &lt;= 0"/>
          <button name="action_create_final_invoice" type="object" string="فاتورة الرصيد" groups="yousentech_booking.group_booking_manager" invisible="state not in ('confirmed','checked_in','checked_out') or invoice_policy != 'deposit'"/>
          <button name="action_register_payment" type="object" string="تسجيل دفعة" class="btn-primary" invisible="invoice_count == 0 or amount_due &lt;= 0"/>
          <button name="action_cancel" type="object" string="إلغاء الحجز" groups="yousentech_booking.group_booking_supervisor" invisible="state in ('draft','cancelled','checked_in','checked_out')"/>
          <button name="action_create_credit_note" type="object" string="إنشاء مرتجع" groups="yousentech_booking.group_booking_manager" invisible="invoice_count == 0"/>
          <button name="action_reopen" type="object" string="إعادة فتح" groups="yousentech_booking.group_booking_supervisor" invisible="state != 'cancelled'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,hold,confirmed,checked_in,checked_out,cancelled"/>
        </header>
        <sheet>
          <field name="invoice_count" invisible="1"/>
          <field name="refund_count" invisible="1"/>
          <field name="payment_count" invisible="1"/>
          <field name="amount_due" invisible="1"/>
          <field name="amount_to_invoice" invisible="1"/>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_history" type="object" class="oe_stat_button" icon="fa-history"><field name="audit_log_count" widget="statinfo" string="السجل"/></button>
            <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="invoice_count == 0"><field name="invoice_count" widget="statinfo" string="الفواتير"/></button>
            <button name="action_view_refunds" type="object" class="oe_stat_button" icon="fa-undo" invisible="refund_count == 0"><field name="refund_count" widget="statinfo" string="المرتجعات"/></button>
            <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money" invisible="payment_count == 0"><field name="payment_count" widget="statinfo" string="المدفوعات"/></button>
          </div>

          <div class="yb-booking-summary-header yb-approved-summary">
            <div class="yb-booking-summary-identity"><div class="yb-booking-icon"><i class="fa fa-bed"/></div><div><small>ملخص الحجز</small><h1><field name="name" readonly="1"/></h1><span class="yb-summary-type">حجز فندقي / إقامة</span></div></div>
            <div class="yb-booking-summary-finance"><div class="yb-finance-strip-values">
              <div class="yb-finance-metric yb-summary-base"><i class="fa fa-bed"/><div class="yb-summary-metric-text"><small>صافي الإقامة والإضافات</small><field name="amount_untaxed" nolabel="1" readonly="1"/></div></div>
              <div class="yb-finance-metric yb-summary-discount"><i class="fa fa-percent"/><div class="yb-summary-metric-text"><small>الخصم</small><field name="discount_amount" nolabel="1" readonly="1"/></div></div>
              <div class="yb-finance-metric yb-summary-tax"><i class="fa fa-file-text-o"/><div class="yb-summary-metric-text"><small>الضريبة</small><field name="tax_amount" nolabel="1" readonly="1"/></div></div>
              <div class="yb-finance-metric yb-finance-total"><i class="fa fa-credit-card"/><div class="yb-summary-metric-text"><small>الإجمالي النهائي</small><field name="amount_total" nolabel="1" readonly="1"/></div></div>
            </div></div>
          </div>
          <div class="yb-event-overview">
            <div class="yb-info-card yb-customer-card"><div class="yb-info-icon purple"><i class="fa fa-user"/></div><div class="yb-info-body yb-customer-fields"><small>بيانات النزيل</small>
              <div class="yb-customer-name"><label for="partner_id" string="النزيل"/><field name="partner_id" nolabel="1" readonly="state not in ('draft','hold')"/></div>
              <div class="yb-customer-detail"><label for="company_id" string="الشركة / الفرع"/><field name="company_id" nolabel="1" readonly="state not in ('draft','hold')"/></div>
            </div></div>
            <div class="yb-info-card yb-venue-card"><div class="yb-info-icon blue"><i class="fa fa-bed"/></div><div class="yb-info-body"><small>بيانات الإقامة</small><div class="yb-venue-compact">
              <div class="yb-venue-hall"><label for="resource_id" string="الغرفة / مورد الإقامة"/><field name="resource_id" nolabel="1" readonly="state not in ('draft','hold')"/></div>
              <div class="yb-event-date"><label for="checkin_date" string="تاريخ الدخول"/><field name="checkin_date" nolabel="1" readonly="state not in ('draft','hold')"/></div>
              <div class="yb-event-date"><label for="checkout_date" string="تاريخ الخروج"/><field name="checkout_date" nolabel="1" readonly="state not in ('draft','hold')"/></div>
            </div></div></div>
          </div>
          <div class="yb-event-workspace">
            <section class="yb-work-card yb-work-package"><div class="yb-work-heading"><i class="fa fa-bed"/><strong>التسعير والإقامة</strong></div>
              <group><field name="rate_plan_id" string="خطة السعر" readonly="state not in ('draft','hold')"/><field name="nights" string="عدد الليالي" readonly="1"/><field name="nightly_price" string="سعر الليلة" readonly="1"/></group>
              <div class="yb-work-help">تُستدعى خطة السعر والضريبة من التهيئة عند إنشاء الحجز، ويمكن تعديل الخطة قبل التأكيد.</div>
            </section>
            <section class="yb-work-card yb-work-addons"><div class="yb-work-heading"><i class="fa fa-plus-circle"/><strong>الإضافات المدفوعة</strong></div>
              <field name="addon_line_ids" nolabel="1" readonly="state not in ('draft','hold')"><tree editable="bottom"><field name="company_id" column_invisible="True"/><field name="addon_id" string="الإضافة"/><field name="quantity" string="الكمية"/><field name="price_unit" string="سعر الوحدة"/><field name="subtotal" string="الإجمالي" readonly="1"/></tree></field>
            </section>
            <section class="yb-work-card yb-work-finance"><div class="yb-work-heading"><i class="fa fa-info-circle"/><strong>تفاصيل التحصيل</strong></div>
              <div class="yb-work-finance-row"><span>المدفوع</span><field name="amount_paid" nolabel="1" readonly="1"/></div>
              <div class="yb-work-finance-row"><span>المتبقي</span><field name="amount_remaining" nolabel="1" readonly="1"/></div>
              <div class="yb-work-finance-row"><span>الحالة المالية</span><field name="finance_state" nolabel="1" readonly="1"/></div>
            </section>
          </div>
          <notebook class="yb-event-tabs">
            <page string="بيانات إضافية"><div class="yb-extra-cards">
              <section class="yb-extra-card yb-extra-discount"><div class="yb-extra-card-title"><i class="fa fa-percent"/><strong>إعدادات الخصم</strong></div>
                <div class="yb-extra-field"><label for="discount_type" string="نوع الخصم"/><field name="discount_type" nolabel="1" readonly="state not in ('draft','hold')"/></div>
                <div class="yb-extra-field" invisible="discount_type == 'none'"><label for="discount_value" string="قيمة الخصم"/><field name="discount_value" nolabel="1" readonly="state not in ('draft','hold')"/></div>
              </section>
              <section class="yb-extra-card yb-extra-notes"><div class="yb-extra-card-title"><i class="fa fa-info-circle"/><strong>تفاصيل احتساب الإقامة</strong></div><group><field name="nights" readonly="1"/><field name="nightly_price" readonly="1"/><field name="amount_untaxed" readonly="1"/><field name="tax_amount" readonly="1"/></group></section>
            </div></page>
            <page string="الإلغاء" invisible="state != 'cancelled'">
              <group>
                <field name="cancel_reason" string="سبب الإلغاء" readonly="1"/>
                <field name="cancelled_by_id" string="ألغاه" readonly="1"/>
                <field name="cancelled_at" string="تاريخ الإلغاء" readonly="1"/>
              </group>
            </page>

            <page string="المالية والفواتير">
              <group>
                <group>
                  <field name="invoice_policy" string="سياسة الفوترة" readonly="state not in ('draft','hold') or invoice_count &gt; 0"/>
                  <field name="deposit_percent" string="نسبة العربون" invisible="invoice_policy != 'deposit'" readonly="state not in ('draft','hold') or invoice_count &gt; 0"/>
                  <field name="finance_state" string="الحالة المالية" readonly="1"/>
                </group>
                <group>
                  <field name="amount_invoiced" string="صافي المفوتر" readonly="1"/>
                  <field name="amount_paid" string="إجمالي المقبوض" readonly="1"/>
                  <field name="amount_refunded" string="المبلغ المسترد" readonly="1"/>
                  <field name="amount_to_refund" string="مطلوب رده للعميل" readonly="1"/>
                  <field name="amount_remaining" string="المطلوب من العميل" readonly="1"/>
                </group>
              </group>
              <field name="payment_schedule_ids" string="جدول الدفعات" invisible="invoice_policy != 'schedule'" readonly="state not in ('draft','hold') or invoice_count &gt; 0">
                <tree editable="bottom">
                  <field name="name" string="الدفعة"/>
                  <field name="due_date" string="تاريخ الاستحقاق"/>
                  <field name="amount" string="المبلغ"/>
                  <field name="state" string="الحالة" readonly="1"/>
                  <field name="invoice_id" string="الفاتورة" readonly="1"/>
                </tree>
              </field>
              <field name="invoice_ids" string="الفواتير والمرتجعات" readonly="1">
                <tree>
                  <field name="name" string="المستند"/>
                  <field name="move_type" string="النوع"/>
                  <field name="invoice_date" string="التاريخ"/>
                  <field name="amount_total" string="الإجمالي"/>
                  <field name="payment_state" string="حالة الدفع"/>
                  <field name="state" string="الحالة"/>
                </tree>
              </field>
            </page>

            <page string="السجل التجاري">
              <field name="commercial_snapshot_ids" string="نسخ الشروط التجارية" readonly="1">
                <tree>
                  <field name="revision" string="المراجعة"/>
                  <field name="amount_total" string="الإجمالي"/>
                  <field name="locked" string="مقفلة"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
        <div class="oe_chatter">
          <field name="message_follower_ids"/>
          <field name="activity_ids"/>
          <field name="message_ids"/>
        </div>
      </form>
    </field>
  </record>

