  <record id="view_booking_demo_setup_form" model="ir.ui.view">
    <field name="name">yousentech.booking.demo.setup.form</field>
    <field name="model">yousentech.booking.demo.setup</field>
    <field name="arch" type="xml">
      <form string="تهيئة البيانات التجريبية">
        <sheet>
          <group>
            <field name="company_id" string="الشركة / الفرع"/>
          </group>
          <div class="alert alert-info" role="alert">
            سيتم إنشاء بيانات تجريبية حسب نوع نشاط الحجز للشركة المحددة، ويمكن تشغيل التهيئة مرة أخرى دون تكرار السجلات الموجودة.
          </div>
        </sheet>
        <footer>
          <button name="action_seed_demo" type="object" string="تهيئة البيانات التجريبية" class="btn-primary"/>
          <button string="إلغاء" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="action_booking_demo_setup" model="ir.actions.act_window">
    <field name="name">تهيئة البيانات التجريبية</field>
    <field name="res_model">yousentech.booking.demo.setup</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <record id="view_booking_settings_tree" model="ir.ui.view">
    <field name="name">yousentech.booking.settings.tree</field>
    <field name="model">yousentech.booking.settings</field>
    <field name="arch" type="xml">
      <tree create="1" delete="0">
        <field name="company_id" string="الشركة / الفرع"/>
        <field name="activity_type" string="نوع نشاط الحجز"/>
        <field name="allow_open_stay" string="السماح بإقامة مفتوحة"/>
      </tree>
    </field>
  </record>

  <record id="view_booking_settings_form" model="ir.ui.view">
    <field name="name">yousentech.booking.settings.form</field>
    <field name="model">yousentech.booking.settings</field>
    <field name="arch" type="xml">
      <form string="إعدادات نظام الحجوزات">
        <sheet>
          <group string="الإعدادات العامة">
            <field name="company_id" string="الشركة / الفرع"/>
            <field name="activity_type" string="نوع نشاط الحجز"/>
          </group>
          <group string="إعدادات الحجوزات الفندقية" invisible="activity_type == 'events'">
            <field name="allow_open_stay" string="السماح بإقامة مفتوحة بدون تاريخ خروج"/>
          </group>
          <div class="alert alert-warning" role="alert">
            بعد بدء عمليات الحجز لا يمكن تغيير نوع النشاط. يمكن إضافة خيارات إعدادات أخرى لهذه الشاشة مستقبلًا.
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_booking_settings" model="ir.actions.act_window">
    <field name="name">إعدادات النظام</field>
    <field name="res_model">yousentech.booking.settings</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'search_default_company_id': active_company_id}</field>
  </record>

</odoo>
