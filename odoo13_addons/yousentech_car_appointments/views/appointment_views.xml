<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_ycc_branch_tree" model="ir.ui.view"><field name="name">ycc.branch.tree</field><field name="model">ycc.branch</field><field name="arch" type="xml"><tree string="تهيئة المواعيد"><field name="name"/><field name="company_id"/><field name="provisional_minutes"/><field name="active"/></tree></field></record>
<record id="view_ycc_branch_form" model="ir.ui.view"><field name="name">ycc.branch.form</field><field name="model">ycc.branch</field><field name="arch" type="xml"><form string="تهيئة مواعيد الفرع"><sheet><div class="oe_title"><h1><field name="name" placeholder="اسم الفرع"/></h1></div><group><group><field name="company_id"/><field name="active"/></group><group><field name="provisional_minutes" help="مدة الحجز المبدئي بالدقائق"/></group></group><notebook><page string="فترات الحجز"><field name="slot_ids" context="{'default_branch_id': active_id}"><tree editable="bottom"><field name="name" readonly="1"/><field name="start_hour" widget="float_time"/><field name="end_hour" widget="float_time"/><field name="capacity"/><field name="weekday_ids" widget="many2many_tags"/><field name="active"/></tree></field></page><page string="إجازات واستثناءات"><field name="exception_ids"><tree editable="bottom"><field name="date"/><field name="slot_id" domain="[('branch_id','=',parent.id)]"/><field name="reason"/></tree></field></page></notebook></sheet></form></field></record>
<record id="view_ycc_appointment_tree" model="ir.ui.view"><field name="name">ycc.appointment.tree</field><field name="model">ycc.appointment</field><field name="arch" type="xml"><tree string="مواعيد العناية بالسيارات" decoration-success="state == 'confirmed'" decoration-warning="state in ('provisional','contacting')" decoration-muted="state in ('cancelled','expired')"><field name="name"/><field name="date"/><field name="branch_id"/><field name="slot_id"/><field name="partner_id"/><field name="vehicle_plate"/><field name="service_id"/><field name="agent_id"/><field name="state"/></tree></field></record>
<record id="view_ycc_appointment_form" model="ir.ui.view"><field name="name">ycc.appointment.form</field><field name="model">ycc.appointment</field><field name="arch" type="xml"><form string="حجز موعد"><header><button name="action_contacting" string="جاري التواصل" type="object" class="oe_highlight" states="provisional"/><button name="action_confirm" string="تأكيد الموعد" type="object" class="oe_highlight" states="provisional,contacting"/><button name="action_done" string="وصلت السيارة" type="object" states="confirmed"/><button name="action_no_show" string="لم يحضر" type="object" states="confirmed"/><button name="action_cancel" string="إلغاء" type="object" states="provisional,contacting,confirmed"/><field name="state" widget="statusbar" statusbar_visible="provisional,contacting,confirmed,done"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group string="الموعد"><field name="branch_id"/><field name="date"/><field name="slot_id" domain="[('branch_id','=',branch_id),('active','=',True)]"/><field name="hold_until" readonly="1"/><field name="agent_id"/></group><group string="العميل والسيارة"><field name="partner_id"/><field name="phone"/><field name="vehicle_plate"/><field name="vehicle_model"/><field name="service_id"/></group></group><notebook><page string="الملاحظات"><field name="notes"/></page><page string="سجل التواصل"><field name="contact_ids"><tree editable="bottom"><field name="contact_at"/><field name="user_id"/><field name="channel"/><field name="result"/><field name="note"/><field name="next_contact_at"/></tree></field><group><field name="next_contact_at"/></group></page></notebook></sheet><div class="oe_chatter"><field name="message_follower_ids" widget="mail_followers"/><field name="activity_ids" widget="mail_activity"/><field name="message_ids" widget="mail_thread"/></div></form></field></record>
<record id="view_ycc_service_tree" model="ir.ui.view"><field name="name">ycc.service.tree</field><field name="model">ycc.service</field><field name="arch" type="xml"><tree editable="bottom"><field name="name"/><field name="estimated_hours"/><field name="price"/><field name="active"/></tree></field></record>
<record id="action_ycc_branch" model="ir.actions.act_window"><field name="name">تهيئة نظام المواعيد</field><field name="res_model">ycc.branch</field><field name="view_mode">tree,form</field></record>
<record id="action_ycc_appointment" model="ir.actions.act_window"><field name="name">تسجيل المواعيد</field><field name="res_model">ycc.appointment</field><field name="view_mode">tree,form</field></record>
<record id="action_ycc_service" model="ir.actions.act_window"><field name="name">خدمات العناية</field><field name="res_model">ycc.service</field><field name="view_mode">tree,form</field></record>
<menuitem id="menu_ycc_root" name="مواعيد العناية بالسيارات" sequence="20"/>
<menuitem id="menu_ycc_calendar" name="تقويم المواعيد" parent="menu_ycc_root" action="action_ycc_calendar" sequence="10"/>
<menuitem id="menu_ycc_appointment" name="تسجيل المواعيد" parent="menu_ycc_root" action="action_ycc_appointment" sequence="20"/>
<menuitem id="menu_ycc_settings" name="تهيئة نظام المواعيد" parent="menu_ycc_root" action="action_ycc_branch" sequence="30"/>
<menuitem id="menu_ycc_services" name="الخدمات" parent="menu_ycc_root" action="action_ycc_service" sequence="40"/>
</odoo>
