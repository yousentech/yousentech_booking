<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="yousentech_booking.BookingOS">
    <div class="yb-os" dir="rtl">
      <div class="yb-topbar">
        <div>
          <div class="yb-kicker">إدارة القاعات والمناسبات</div>
          <h1 t-esc="state.viewMode === 'month' ? 'مخطط الحجوزات الشهري' : 'مخطط حجوزات القاعات'"/>
          <p t-esc="state.viewMode === 'month' ? 'عرض جميع أيام الشهر مع الحجوزات والإجازات.' : 'رؤية أسبوعية للحجوزات والإجازات بالتاريخ الميلادي والهجري.'"/>
        </div>
        <button class="yb-primary" t-on-click="() => this.newBooking()">+ حجز جديد</button>
      </div>

      <div class="yb-toolbar">
        <div class="yb-date-nav">
          <div class="yb-view-switch">
            <button t-att-class="state.viewMode === 'week' ? 'is-active' : ''" t-on-click="() => this.setViewMode('week')">أسبوعي</button>
            <button t-att-class="state.viewMode === 'month' ? 'is-active' : ''" t-on-click="() => this.setViewMode('month')">شهري</button>
          </div>
          <button class="yb-icon-btn" t-on-click="() => this.shiftPeriod(1)">‹</button>
          <div class="yb-month"><strong t-esc="monthTitle"/><small>ميلادي • أم القرى</small></div>
          <button class="yb-icon-btn" t-on-click="() => this.shiftPeriod(-1)">›</button>
          <button class="yb-soft-btn" t-on-click="goToday">اليوم</button>
        </div>
        <div class="yb-filters">
          <div class="yb-search" t-if="state.viewMode === 'week'"><i class="fa fa-search"/><input placeholder="ابحث عن قاعة..." t-on-input="onSearch"/></div>
          <select t-on-change="onHallFilter"><option value="all">جميع القاعات</option><t t-foreach="state.halls" t-as="hall" t-key="hall.id"><option t-att-value="hall.id" t-esc="hall.name"/></t></select>
        </div>
      </div>

      <div class="yb-stats">
        <article><span class="yb-stat-icon green"><i class="fa fa-calendar-check-o"/></span><div><small>مناسبات اليوم</small><strong t-esc="visibleStats.today"/></div></article>
        <article><span class="yb-stat-icon amber"><i class="fa fa-hourglass-half"/></span><div><small>حجوزات مؤقتة</small><strong t-esc="visibleStats.holds"/></div></article>
        <article><span class="yb-stat-icon blue"><i class="fa fa-building-o"/></span><div><small>القاعات النشطة</small><strong t-esc="state.halls.length"/></div></article>
        <article><span class="yb-stat-icon violet"><i class="fa fa-calendar"/></span><div><small>حجوزات الفترة</small><strong t-esc="visibleStats.total"/></div></article>
      </div>

      <section class="yb-board">
        <div class="yb-board-loading" t-if="state.loading"><i class="fa fa-spinner fa-spin"/> جاري تحميل المخطط...</div>
        <t t-else="">
          <div class="yb-month-calendar" t-if="state.viewMode === 'month'">
            <div class="yb-month-weekdays">
              <div>السبت</div><div>الأحد</div><div>الاثنين</div><div>الثلاثاء</div><div>الأربعاء</div><div>الخميس</div><div>الجمعة</div>
            </div>
            <div class="yb-month-days">
              <div t-foreach="monthCalendarDays" t-as="day" t-key="iso(day)"
                   t-att-class="{'yb-month-day': true, 'is-outside': !isCurrentMonth(day), 'is-today': isToday(day), 'is-holiday': isHoliday(day)}"
                   t-on-click="() => this.newBooking(false, day)">
                <div class="yb-month-day-heading">
                  <strong t-esc="monthDayNumber(day)"/>
                  <span class="yb-month-today" t-if="isToday(day)">اليوم</span>
                </div>
                <div class="yb-month-holidays" t-if="isHoliday(day)">
                  <span t-foreach="holidaysFor(day)" t-as="holiday" t-key="holiday.id" class="yb-month-holiday"><i class="fa fa-umbrella"/> <t t-esc="holiday.name"/></span>
                </div>
                <div class="yb-month-bookings">
                  <button t-foreach="monthEvents(day).slice(0, 1)" t-as="event" t-key="event.id"
                          t-att-class="'yb-month-booking ' + eventClass(event)"
                          t-on-click.stop="() => this.openEvent(event)">
                    <span class="yb-month-booking-head"><strong t-esc="event.name"/><small t-esc="eventLabel(event)"/></span>
                    <span class="yb-month-booking-detail" t-if="event.partner_id" t-esc="event.partner_id[1]"/>
                    <span class="yb-month-booking-hall" t-esc="monthEventLabel(event)"/>
                  </button>
                  <button t-if="monthEvents(day).length > 1" class="yb-month-more yb-month-more-compact"
                          t-on-click.stop="() => this.openDayBookings(day)">
                    +<t t-esc="monthEvents(day).length - 1"/> حجوزات أخرى
                  </button>
                </div>
              </div>
            </div>
          </div>
          <t t-else="">
          <div class="yb-grid-head" t-att-style="gridStyle">
            <div class="yb-hall-head">القاعات</div>
            <div t-foreach="displayDays" t-as="day" t-key="iso(day)" t-att-class="{'yb-day-head': true, 'is-today': isToday(day), 'is-holiday': isHoliday(day)}">
              <strong t-esc="gregorian(day)"/><small t-esc="hijri(day)"/>
              <span class="yb-holiday-tag" t-if="isHoliday(day)"><i class="fa fa-star"/> <t t-esc="holidaysFor(day)[0].name"/></span>
            </div>
          </div>
          <div class="yb-hall-row" t-att-style="gridStyle" t-foreach="visibleHalls" t-as="hall" t-key="hall.id">
            <div class="yb-hall-cell">
              <div class="yb-hall-avatar"><i class="fa fa-building"/></div>
              <div><strong t-esc="hall.name"/><small t-if="hall.capacity"><i class="fa fa-users"/> <t t-esc="hall.capacity"/> شخص</small></div>
            </div>
            <div t-foreach="displayDays" t-as="day" t-key="iso(day)" t-att-class="isHoliday(day) ? 'yb-day-cell is-holiday' : 'yb-day-cell'" t-on-click="() => this.newBooking(hall.id, day)">
              <t t-foreach="eventsFor(hall, day)" t-as="event" t-key="event.id">
                <button t-att-class="'yb-event ' + eventClass(event)" t-on-click.stop="() => this.openEvent(event)">
                  <span class="yb-event-top"><strong t-esc="event.name"/><em t-esc="eventLabel(event)"/></span>
                  <span t-if="event.partner_id" t-esc="event.partner_id[1]"/>
                  <small t-if="event.period_ids.length"><i class="fa fa-clock-o"/> <t t-esc="event.period_ids.length"/> فترة</small>
                </button>
              </t>
              <span class="yb-add-slot">+ حجز</span>
            </div>
          </div>
          </t>
          <div class="yb-empty" t-if="state.viewMode === 'week' &amp;&amp; !visibleHalls.length">لا توجد قاعات مطابقة للبحث.</div>
        </t>
      </section>

      <div t-if="state.selectedDay" class="yb-day-overlay" t-on-click="() => this.closeDayBookings()">
        <aside class="yb-day-panel" t-on-click.stop="() => {}">
          <header class="yb-day-panel-header">
            <button class="yb-day-close" t-on-click="() => this.closeDayBookings()" aria-label="إغلاق"><i class="fa fa-times"/></button>
            <h3>حجوزات يوم <t t-esc="state.selectedDay"/></h3>
            <small><t t-esc="dayEvents(state.selectedDay).length"/> حجوزات</small>
          </header>
          <div class="yb-day-panel-list">
            <button t-foreach="dayEvents(state.selectedDay)" t-as="event" t-key="event.id"
                    t-att-class="'yb-day-panel-event ' + eventClass(event)"
                    t-on-click="() => this.openEvent(event)">
              <span class="yb-day-panel-event-head"><strong t-esc="event.name"/><em t-esc="eventLabel(event)"/></span>
              <span t-esc="event.hall_id ? event.hall_id[1] : ''"/>
              <small t-if="event.partner_id" t-esc="event.partner_id[1]"/>
            </button>
          </div>
          <button class="yb-day-panel-all" t-on-click="() => this.openDayBookingsList(new Date(state.selectedDay + 'T12:00:00'))">عرض جميع حجوزات هذا اليوم <i class="fa fa-arrow-left"/></button>
        </aside>
      </div>
      <div class="yb-legend">
        <span><i class="dot holiday"/> إجازة</span><span><i class="dot confirmed"/> مؤكد</span><span><i class="dot hold"/> مؤقت</span><span><i class="dot preparing"/> تجهيز</span><span><i class="dot event"/> فعالية قائمة</span><span><i class="dot completed"/> مكتمل</span>
        <small>اضغط على اليوم لإنشاء حجز، أو على بطاقة الحجز لفتح تفاصيله.</small>
      </div>
    </div>
  </t>
</templates>
